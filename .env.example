# tg-proxy — Configuration
# Created by: tg-proxy admin setup
# Located at: ~/.config/tg-proxy/.env
# Owner-only permissions are enforced: directory 0700, file 0600.
# Bot tokens are retrieved by `tg-proxy do bot-token` and stored as
# BOT_USERNAME_TOKEN=<token>. Never commit a populated .env file.

TG_API_ID=your_api_id_here
TG_API_HASH=your_api_hash_here
